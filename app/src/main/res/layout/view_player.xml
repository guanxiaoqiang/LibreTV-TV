<?xml version="1.0" encoding="utf-8"?>
<!--
  The player surface is a TextureView on purpose.

  A SurfaceView lives in its own hardware layer that always sits on top of the
  window, so the Compose control panel drawn over the video would be invisible
  and completely unusable with a remote. A TextureView is composited inside the
  view hierarchy, which keeps the control strip, the top info bar and the
  touch targets on top of the picture.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:show_buffering="never"
    app:keep_content_on_player_reset="true" />
